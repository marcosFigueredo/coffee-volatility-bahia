@BOOK{Luo202666,
	author = {Luo, Pengrui},
	title = {Coffee Genomics: Mapping and Sequencing},
	year = {2026},
	journal = {Coffee Science and Biotechnology: Genomic Biochemical and Nanotechnological Perspectives},
	pages = {66 - 86},
	doi = {10.1201/9781003689393-3},
	url = {https://www.scopus.com/pages/publications/105045087235?origin=resultslist},
	abstract = {Coffee (Coffea spp.) is one of the most widely consumed beverages worldwide and a cornerstone agricultural commodity that sustains the livelihoods of millions of smallholder farmers, particularly in tropical regions. Over the past two decades, rapid advances in genomic technologies have fundamentally transformed our understanding of coffee biology, evolution, and improvement. High-throughput sequencing, long-read platforms (PacBio HiFi and Oxford Nanopore), chromosome conformation capture technologies (Hi-C), and sophisticated bioinformatics pipelines have enabled the generation of high-quality, chromosome-scale genome assemblies for several Coffea species. These resources have provided unprecedented insights into genome architecture, gene content, structural variation, and the evolutionary consequences of polyploidy, particularly in allotetraploid Coffea arabica. This chapter provides a comprehensive overview of recent progress in coffee genomics, with a particular emphasis on genome architecture, genetic and physical mapping, sequencing strategies, and functional annotation. The genetic diversity and domestication history of Coffea species are discussed alongside the challenges posed by genome size variation and subgenome complexity. Advances in high-density SNP mapping, genotyping-by-sequencing, quantitative trait locus (QTL) analysis, and genome-wide association studies (GWAS) have greatly improved the resolution at which agronomically important traits-such as yield, cup quality, caffeine content, and resistance to pests and diseases-can be dissected. The integration of genetic linkage maps with physical genome assemblies has further strengthened trait localisation and comparative genomic analyses across Coffea species. The chapter also highlights the implications of these genomic resources for modern coffee breeding. Marker-assisted selection, genomic selection, and machine learning-based predictive models are increasingly enabling data-driven breeding strategies that accelerate genetic gain in this perennial crop. Furthermore, the emergence of pan-genomic frameworks and the systematic inclusion of wild Coffea relatives offer powerful opportunities to broaden the narrow genetic base of cultivated Arabica coffee and enhance resilience to climate change. Finally, key challenges and future directions are discussed, including haplotype-resolved genome assembly, structural variation analysis, ethical governance of genomic resources, and the integration of genomics with systems biology, phenomics, and environmental modelling. Together, these advances position coffee genomics as a critical foundation for sustainable crop improvement, supporting the development of climate-resilient, high-quality cultivars and safeguarding the long-term future of global coffee production. © 2027 Erdi Can Aytar.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Iro2025,
	author = {Iro, Zaharaddeen Salele and Abdulrasheed, Salisu and Subramani, C.},
