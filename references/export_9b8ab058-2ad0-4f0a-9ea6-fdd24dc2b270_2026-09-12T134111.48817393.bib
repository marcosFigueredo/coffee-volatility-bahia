	title = {FORECASTING MODEL FOR AGRICULTURE COMMODITIES PRICE USING MACHINE LEARNING TECHNIQUES: A SYSTEMATIC REVIEW},
	year = {2024},
	journal = {Journal of Environmental Protection and Ecology},
	volume = {25},
