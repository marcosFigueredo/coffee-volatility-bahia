	abstract = {Accurate forecasting of agricultural commodity prices is essential for strategic decision-making in agro-industrial systems exposed to climatic and economic volatility. This study develops and rigorously stress-tests a Competitive Ensemble Regression (CER) framework for forecasting annual Free on Board (FOB) export prices of four citrus species (orange, mandarin, lemon, and grapefruit) in Corrientes Province, Argentina, using a multidecadal dataset (1970–2023) that integrates agroclimatic, productive, and macroeconomic variables from two INTA experimental stations. Six machine learning regressors (SVR, GPR, Decision Tree, Random Forest, XGBoost, and MLP) were benchmarked under a leakage-free, expanding-window walk-forward protocol (2013–2023) and integrated via an online, percentile-truncated Roulette Wheel Selection mechanism (CER_trunc). A BDS test confirms nonlinear price dynamics for grapefruit, lemon, and orange, but not mandarin. No single model dominates uniformly: XGBoost achieves the lowest error for mandarin (SMAPE = 7.22%), SVR for lemon (8.74%), and Random Forest for orange (28.03%). Under the corrected design, replicated across two independent configurations, the competitive ensemble does not exceed the best individual model for any species, a robust, mechanism-independent finding rather than an artifact of the original implementation. Overfitting analysis shows GPR to be markedly unstable (test/train RMSE ratio = 83.4×) relative to MLP, DT, SVR, and RF (all below 2.6×). Feature-importance analysis (permutation and SHAP) identifies productive volume, lagged FOB, and agroclimatic extremes as the dominant predictors. Mandarin is the best-forecast species (SMAPE 7.2–9.3%), outperforming six literature benchmarks by 51–63%, while grapefruit remains genuinely hard to forecast due to a documented 2016–2019 export-duty policy shock rather than a modeling deficiency. These findings delineate the conditions under which competitive ensemble learning helps or harms forecast accuracy in volatile agro-economic systems, with direct implications for real-time export-price monitoring. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Guindani2024,
	author = {Guindani, Luana Gonçalves and Oliveirai, Gilson Adamczuk and Ribeiro, Matheus Henrique Dal Molin and Gonzalez, Gabriel Villarrubia and de Lima, José Donizetti},
