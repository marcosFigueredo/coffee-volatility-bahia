}

@CONFERENCE{Hossain2026,
	author = {Hossain, Arman and Palas, Md. Rajibul and Quader, Montaser Abdul and Alam, Md. Shoab and Quader, Mozdaher Abdul},
	title = {GRU-Based Time-Series Forecasting of Agricultural Commodity Prices Using Market and Climate Data},
