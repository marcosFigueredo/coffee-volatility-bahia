}

@CONFERENCE{Shobha2025,
	author = {Shobha, P. and Apeksha, T.S. and Apoorva, N. and Bhavana, A.N. and Kunkanad, Gagan S},
	title = {Intelligent Forecasting of Agricultural Markets using Ensemble of ARIMA, Prophet, LSTM, and GARCH},
	year = {2025},
	journal = {Proceedings of 2025 6th International Conference on Communication, Computing and Industry 6.0, C2I6 2025},
	pages = {},
	doi = {10.1109/C2I666499.2025.11366981},
	url = {https://www.scopus.com/pages/publications/105034388898?origin=resultslist},
	abstract = {Accurate forecasting of agricultural commodity prices is vital for farmers, cooperatives, traders, and policymakers to reduce risks and improve market strategies. Traditional approaches such as ARIMA and SARIMA are effective for modeling linear dependencies but fail to capture nonlinear dynamics, volatility, and sudden structural shifts in agricultural markets. To address these challenges, this paper proposes Intelligent Forecasting of Agricultural Markets using an Ensemble of ARIMA, Prophet, LSTM, and GARCH. The framework combines the corresponding strengths of statistical and deep learning models: ARIMA captures linear temporal trends, Prophet models seasonality, LSTM learns nonlinear longterm dependencies, and GARCH explicitly quantifies volatility clustering. Forecasts are integrated through an inverse RMSE weighted ensemble, and a risk aware decision support layer incorporates volatility adjusted profit margins and transport costs to translate predictions into actionable insights. Experimental results on AGMARKNET commodity price data demonstrate that the ensemble outperforms individual models, achieving an MAE of 848.6, RMSE of 1325.9, and MAPE of 12.4, compared to higher errors from ARIMA, Prophet, and LSTM. Beyond predictive accuracy, the proposed framework bridges the gap between statistical precision and real-world applicability, enabling stakeholders to make risk adjusted decisions for sustainable agricultural market management. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tamimu2026,
	author = {Tamimu, Mohammed Gadafi and Zhao, Shurong and Xu, Qianwen and Zhang, Jie},
	title = {Attention-Based Deep Learning Hybrid Model for Cash Crop Price Forecasting: Evidence from Global Futures Markets with Implications for West Africa},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {3},
	pages = {},
	doi = {10.3390/app16031600},
	url = {https://www.scopus.com/pages/publications/105030106335?origin=resultslist},
	abstract = {Accurate forecasting of agricultural commodity prices is essential for managing market volatility, improving supply chain coordination, and supporting food security-related decision-making. Recent advances in deep learning have demonstrated strong potential for capturing nonlinear and temporal dependencies in commodity price dynamics. In this study, we propose a hybrid long short-term memory–multi-head attention (LSTM–MHA) framework for agricultural commodity price forecasting using global futures market data. The model is trained and evaluated on multivariate global commodity futures prices, reflecting internationally traded benchmark markets rather than region-specific domestic prices. While the empirical analysis is based on global data, the study is motivated by the relevance of international price movements for import-dependent regions, particularly West Africa, where global price transmission plays a critical role in domestic market dynamics. The experimental results demonstrate that the proposed model effectively captures short-term temporal dependencies and provides interpretable attention-based insights into lag relevance. An ablation study further highlights the trade-offs between forecasting accuracy and interpretability across different model configurations. The hybrid architecture combines the time-based pattern identification and weighting capabilities of multi-head attention with the sequential learning capabilities of LSTM. Mean absolute error (MAE), root mean squared error (RMSE), and mean squared error (MSE) were used to evaluate the model’s performance. With an MSE of 0.0124, an RMSE of 0.1114, and an MAE of 0.1097, the model outperformed conventional models like ARIMA and standalone LSTM by three to four times in error reduction. The findings suggest that attention-enhanced deep learning models can serve as valuable analytical tools for understanding global price dynamics and informing policy analysis and risk management in West African agricultural markets. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
