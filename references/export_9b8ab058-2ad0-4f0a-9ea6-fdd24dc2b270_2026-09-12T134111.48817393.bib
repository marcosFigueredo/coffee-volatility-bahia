	url = {https://www.scopus.com/pages/publications/105041698131?origin=resultslist},
	abstract = {Accurate agricultural commodity price prediction is crucial for ensuring economic stability, improving market efficiency, and supporting informed decision-making. This paper evaluates the efficiency of various machine learning models, including Ensemble Learning, SARIMA, and XGBoost, in forecasting the prices of sesame and hibiscus commodities. The study reveals that SARIMA outperforms Ensemble Learning in predicting sesame prices, achieving RMSE values of 200.12, 195.34, and 188.12, MAE values of 190.45, 185.67, and 180.34, and R<sup>2</sup> values of 0.987, 0.985, and 0.983 across 12, 24, and 48-week horizons, respectively. SARIMA's superiority is attributed to its ability to effectively model the strong seasonal and autoregressive patterns prevalent in sesame price trends. Conversely, XGBoost delivers the most accurate results for hibiscus, consistently achieving the lowest RMSE values of 100.23, 97.56, and 95.12, MAE values of 95.67, 93.45, and 90.78, and R<sup>2</sup> values of 0.990, 0.988, and 0.985 across the same forecast intervals. This exceptional performance is due to XGBoost's strength in capturing complex nonlinear relationships and subtle feature interactions, particularly influenced by export dynamics and fluctuating demand in hibiscus markets. These results highlight the importance of model selection tailored to commodity-specific price behavior and underlying market structures. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
