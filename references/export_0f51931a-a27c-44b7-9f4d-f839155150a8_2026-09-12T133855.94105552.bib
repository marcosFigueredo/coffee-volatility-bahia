	url = {https://www.scopus.com/pages/publications/105046845452?origin=resultslist},
	abstract = {This paper aims to explore the time–frequency and asymmetric spillovers of climate risks on the Chinese agricultural commodity markets. The time-varying parameter stochastic volatility vector regression model (TVP-SV-VAR) and the DY spillover index are adopted to analyze the time-varying spillover effects of climate physical risk and climate transition risk on agricultural commodity markets. The results reveal that among all of them, wheat is the most vulnerable to both climate physical and transition risks. Rapeseed oil acts as the greatest risk transmitter, while wheat is the greatest risk receiver. Frequency-domain spillovers measured via the BK spillover index suggest that the spillover relationship between climate risks and agricultural markets presents a long-term amplification effect. Regardless of physical risk or transition risk, the impacts of negative climate shocks on most agricultural markets are significantly greater than those of positive shocks. This study provides a scientific basis for policymakers to formulate targeted agricultural climate adaptation policies and establish a differentiated risk prevention system. It also provides practical implications for agricultural market participants to optimize risk management strategies and design asymmetric climate-related hedging instruments. Copyright © 2026. Published by Elsevier Inc.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Byrareddy2026,
	author = {Byrareddy, Vivekananda M and Shaik, Thanveer and Kouadio, Louis and Bhattarai, Utsav and Nguyen-Huy, Thong and Mushtaq, Shahbaz},
	title = {Explainable machine learning approaches for climate‑driven forecasting of global Arabica coffee prices},
	year = {2026},
	journal = {Smart Agricultural Technology},
