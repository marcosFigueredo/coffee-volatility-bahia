@ARTICLE{Pinitjitsamut2026,
	author = {Pinitjitsamut, Montchai},
	title = {Timing commodity sales under tail-risk control: State-dependent rules and global price signals in rubber markets},
	year = {2026},
	journal = {International Review of Economics and Finance},
	volume = {111},
	pages = {},
	doi = {10.1016/j.iref.2026.105622},
	url = {https://www.scopus.com/pages/publications/105045553711?origin=resultslist},
	abstract = {Producers of agricultural commodities must decide not only at what price to sell but when—often under delayed information, pressing cash needs, and the asymmetric threat of sharp price falls that matter more to them than equivalent price rises. This study asks whether simple, rule-based selling decisions, built only from price signals a producer could actually observe at the moment of sale, can protect natural rubber sellers against downside price risk without sacrificing average returns. Using weekly data from Thai rubber markets (2015–2025), it constructs state-dependent selling rules that translate observable global price signals — futures and export benchmarks — into weekly selling decisions under a strict no-look-ahead design. Rather than judging these rules by forecast accuracy, the study evaluates them by the economic outcomes they deliver: average realised prices and downside-risk measures, including the frequency of low-price sales and conditional value-at-risk, assessed through rolling out-of-sample implementation. The rules are compared with selling immediately and with forecast-based trigger rules, including a benchmark that uses the same information. A formal decomposition identifies which signals contribute most to downside protection, and the results are shown to be stable across alternative downside-penalty specifications. The state-dependent rules significantly outperform the forecast-based trigger rules, while their mean realised price is statistically indistinguishable from immediate sale; the downside-risk gain is concentrated in a lower frequency of low-price sales rather than in conditional value-at-risk. The findings indicate that how selling decisions are executed — rather than the precision of price forecasts — is central to managing downside risk in natural rubber markets, with transferable lessons for other commodity settings where producers face information delays and volatile prices. © 2026 The Author.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Yana2026,
