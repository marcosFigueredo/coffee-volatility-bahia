@ARTICLE{Bhusal2026,
	author = {Bhusal, Bivek and Legrand, Ana and Witharana, Chandi},
	title = {Detecting potato leafhopper infestation in beans using hyperspectral leaf-level sensing},
	year = {2026},
	journal = {Computers and Electronics in Agriculture},
	volume = {248},
	pages = {},
	doi = {10.1016/j.compag.2026.111791},
	url = {https://www.scopus.com/pages/publications/105036820799?origin=resultslist},
	abstract = {Potato leafhopper (PLH; Empoasca fabae Harris) is a sap-feeding pest known for its wide host range and high damage potential. Although known to cause significant yield losses across agricultural commodities including beans, spectral signatures of PLH induced stress in beans have not yet been explored. To address this gap, a greenhouse study was conducted to evaluate the capability of hyperspectral reflectance sensing in detecting PLH stress. Specifically, the study aimed to characterize hyperspectral responses of PLH stress in beans, assess the effects of infestation density and duration, and identify consistent stress-sensitive spectral regions across bean varieties. The study included three bean varieties- Provider (Phaseolus vulgaris), Henderson's Bush Lima (Phaseolus lunatus), and Tiger's Eye (Phaseolus vulgaris)- where beans were subjected to varying densities and durations of PLH infestation. Generalized additive mixed models (GAMMs) with cubic regression splines were employed to capture the non-linear wavelength-specific reflectance responses on beans under varying PLH infestation. Pairwise differences among the infestation-specific smooths were calculated to identify spectral regions (500–1000 nm) where reflectance differed significantly. Results of the study identified, for each variety, spectral regions within the visible and near-infrared (NIR) spectrum where leaf reflectance differed among the healthy and infested beans. Results revealed that PLH feeding stress induced distinct, wavelength-specific and variety-dependent reflectance shifts across the spectrum. With increased infestation duration, reflectance differences were evident across broader spectral regions of the visible and NIR spectrum, although the magnitude and direction of reflectance responses varied among varieties. Provider and Henderson's Bush Lima exhibited pronounced spectral separation with increasing infestation duration, while Tiger's Eye showed delayed response, requiring higher infestation pressure for clear differentiation. These findings provide the first evidence that PLH-induced feeding damage in beans can be detected using leaf reflectance, offering a novel reflectance-based approach for monitoring crop stress caused by PLH. The study establishes a foundation for developing reflectance-based tools for early detection and scalable monitoring of PLH stress in precision agriculture. © 2026 Elsevier B.V.},
	publication_stage = {Final}
}

@ARTICLE{Hentschl20261449,
	author = {Hentschl, Moritz and Michalke, Amelie and Pieper, Maximilian and Gaugler, Tobias and Stoll-Kleemann, Susanne},
	title = {Dietary change and land use change: assessing preventable climate and biodiversity damage due to meat consumption in Germany},
