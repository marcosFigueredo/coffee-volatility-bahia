@ARTICLE{Yang20261,
	author = {Yang, Shilong and Li, Congxi and Tan, Yanwen and Long, Wenjun},
	title = {Changes in the Sino-US agricultural trade pattern amidst high tariff: simulations of the US “reciprocal tariffs” via the GTAP model},
