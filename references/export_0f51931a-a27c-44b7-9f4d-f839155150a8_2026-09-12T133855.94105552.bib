@ARTICLE{Singh20261482,
	author = {Singh, Ankit Kumar and Yeasin, Md and Paul, Ranjit Kumar and Sarkar, Anita and Paul, A.K.},
	title = {P-WEV: PSO Based Weighted Ensemble Technique for Agricultural Food Price Volatility Modeling},
	year = {2026},
	journal = {Agribusiness},
