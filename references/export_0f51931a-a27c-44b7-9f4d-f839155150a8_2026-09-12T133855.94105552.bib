	url = {https://www.scopus.com/pages/publications/105043996807?origin=resultslist},
	abstract = {Biocontrol strategies leveraging microbial antagonism hold promise as effective alternatives to chemically synthesized antifungal agents. Regrettably, the current understanding of the mechanisms underlying microbial antagonistic interactions remains limited, thereby impeding the advancement of research and development in microbial antagonists. Consequently, this article aims to not only elucidate the traditional mechanisms of microbial antagonism but also incorporate novel mechanistic insights. To facilitate comprehension of these intricate mechanisms, this article has employed visual representations. Furthermore, the inhibitory effects of microbial antagonists on mycotoxin production in agricultural products are systematically analyzed. Additionally, this work discusses the predominant fungal spoilage species in various agricultural commodities and existing control strategies. Finally, this review summarizes the sources and advantages of microbial antagonists and their potential applications in the biological control of agricultural products. This article intends to provide theoretical guidance and inspiration for the development of novel, highly effective antifungal agents based on microbial antagonism mechanisms. © 2026 Institute of Food Technologists.},
	publication_stage = {Final}
}

@ARTICLE{Tola2026,
	author = {Tola, Tamirat Demissie and Wayesa, Negeri Negese and Obsu, Legesse Lemecha},
	title = {Delay-Fractional Mathematical Model for Coffee Berry Disease with Vector Dynamics},
	year = {2026},
	journal = {Scientific African},
	volume = {33},
	pages = {},
	doi = {10.1016/j.sciaf.2026.e03536},
	url = {https://www.scopus.com/pages/publications/105046018983?origin=resultslist},
	abstract = {Coffee is a widely cultivated agricultural commodity and a cornerstone of the global economy. It grows optimally in humid tropical and subtropical highlands characterized by moderate temperatures. However, Coffee Berry Disease (CBD) poses a significant threat to this sector. This destructive fungal infection affects Coffea arabica and continues to impact yield and economic sustainability in major producing regions. Existing mathematical models for CBD rely on classical integer-order formulations. These models often fail to capture biological memory and intrinsic delays in disease development. This study presents the delay fractional-order model for CBD dynamics. We utilize the Atangana–Baleanu–Caputo (ABC) fractional derivative. This operator provides a flexible mathematical structure to represent long-term memory effects through a nonsingular kernel. First, we establish the Positivity and boundedness of solutions to ensure biological relevance. Next, we derive the disease-free and endemic equilibria and obtain the basic reproduction number via the next-generation matrix method. We investigate local stability using linearization and the Routh–Hurwitz criteria. Numerical approximations are computed using an Adams–Bashforth–Moulton predictor–corrector scheme. We also employ Python-based simulations to validate our analytical findings. The results show that fractional memory and time-delay effects substantially shape CBD dynamics. Specifically, these factors extend disease persistence and yield losses. By integrating memory, delays, and nonlinear transmission, our model offers a comprehensive framework. It aims to inform effective CBD management strategies under varying climatic conditions. © 2026 Published by Elsevier B.V. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Ghonge2026,
	author = {Ghonge, Vilas Damodhar and Kulkarni, Yogesh},
	title = {An advanced wide-and-deep learning framework for soybean price forecasting using market, weather, trade, and supply data},
	year = {2026},
	journal = {MethodsX},
	volume = {17},
	pages = {},
	doi = {10.1016/j.mex.2026.104030},
	url = {https://www.scopus.com/pages/publications/105043786668?origin=resultslist},
	abstract = {Precise prediction of agricultural commodity prices is key to assisting farmers, traders, policymakers and supply chain stakeholders to alleviate the uncertainty, and enable them to make sound decisions. The fluctuation in the price of soybean is very unpredictable because of the interplay of market forces, weather unpredictability, trade, output and farming methods. This paper suggests a multi-source machine learning model that is capable of forecasting the accurate price of soy beans using past market prices, arrivals, trade as well as weather forecasting, crop supply and area under cultivation. The dataset of a complete prediction of the prices of soybean between Jan 2015 to March 2026 was built by using the data provided in AGMARKNET, NCDEX, government trade portals, meteorological agencies and state agricultural databases. Exploratory data analysis was done to learn price distributions and regional differences, then systematic data preprocessing, normalization and feature engineering such as rainfall deviation, price range and arrivals per cultivation area was done. Several machine learning and deep learning models were implemented, such as Random Forest, Gradient Boosting, XGBoost, ensemble methods, dense neural network, attention-based models, and a proposed Wide and Deep Network (AgroWDN) was tested. RMSE, MAE, MSE and R<sup>2</sup> measures were used to evaluate model performance on training, validation and test datasets. Experimental outcomes depict that AgroWDN model is, by all means, more efficient than the traditional machine learning and deep learning methods, making the least prediction errors and R<sup>2</sup> at 98.97; it implies a high predictive performance. These results prove that the method of multi-source data fusion and hybrid deep learning structures are effective in price prediction in agriculture. The suggested framework provides a scalable and useful solution to the profitable prediction of soybean prices and may be applied to other crops and markets. © 2026 The Author(s). Published by Elsevier B.V. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Yu2026,
