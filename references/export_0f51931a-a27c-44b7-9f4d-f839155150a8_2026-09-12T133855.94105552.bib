}

@ARTICLE{Hamida2026,
	author = {Hamida, Hela Ben},
	title = {Half a Century of Global Agricultural Commodity Connectedness Under Geopolitical Risk: The Role of Threats and Acts (1975–2026)},
	year = {2026},
