@ARTICLE{Kumar2026,
	author = {Kumar, Prabhat and Kumar, Rajeev Ranjan and Jha, Girish Kumar},
	title = {Agricultural commodity price forecasting through a hybrid EMD-SSA double decomposition approach},
	year = {2026},
	journal = {Discover Computing},
	volume = {29},
	number = {1},
	pages = {},
	doi = {10.1007/s10791-026-10076-2},
	url = {https://www.scopus.com/pages/publications/105034424089?origin=resultslist},
	abstract = {Agricultural commodity price series often exhibit high volatility, nonlinearity, and irregular fluctuations, posing significant challenges for accurate forecasting. To address these complexities, this study proposes a novel hybrid EMD-SSA-TDNN model that combines Empirical Mode Decomposition (EMD), Singular Spectrum Analysis (SSA), and Time-Delay Neural Networks (TDNN). The modelling process begins with EMD, which decomposes the original series into a set of Intrinsic Mode Functions (IMFs) and a residual component. Notably, the first IMF, typically characterized by high-frequency noise, is found to negatively affect predictive performance. Rather than discarding this component, SSA is applied to IMF1 to extract its underlying trend, thereby preserving valuable signal information. The reconstructed trend from IMF1 is then merged with the remaining components and fed into a TDNN to effectively capture temporal dependencies and nonlinear patterns. The proposed model is evaluated on maize and soybean price series using multiple window lengths (12, 36, and 48) and different Trend Rate (TR) thresholds (0%, 85%, 90%, 95%, and 100%) across 1, 3 and 6-step forecasting horizons, with performance assessed through MAE, RMSE, MAPE, and Diebold-Mariano statistical tests. Experimental results demonstrate that the EMD-SSA-TDNN model consistently outperforms benchmark approaches including SVR, EMD-SVR, ARIMA, EMD-ARIMA, TDNN, and EMD-TDNN, achieving significantly lower forecasting errors with statistical significance at the 5% level. The analysis further reveals that TR, window length, and forecasting step jointly influence prediction accuracy, where TR = 85% is generally optimal for short-term forecasting, while TR ≈ 90–95% improves multi-step performance. A window length of 36 often provides a balanced trade-off between noise reduction and trend preservation, whereas very small or very large windows may reduce stability in extended horizons. © The Author(s) 2026.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Abdallah2026,
	author = {Abdallah, M.M.S. and El Sebai, T.N.M. and Bakry, B.A. and Sadak, M.S. and El-Bassiouny, H.M.S.},
	title = {Combined effect of microbial and non-microbial biostimulants on wheat growth, yield, and grain nutritional quality under sandy soil conditions},
	year = {2026},
	journal = {BMC Plant Biology},
	volume = {26},
	number = {1},
	pages = {},
	doi = {10.1186/s12870-026-09659-4},
	url = {https://www.scopus.com/pages/publications/105047317935?origin=resultslist},
	abstract = {Background: The agricultural use of sandy soils has expanded worldwide to meet the increasing demand for food and other agricultural commodities resulting from rapid population growth and urbanization. However, the inherent limitations of these soils, particularly their low capacity to retain water and nutrients, pose major challenges to sustainable crop production. Accordingly, field experiments were conducted to assess the effectiveness of integrated microbial and non-microbial biostimulants in improving the performance of wheat (Triticum aestivum L. cv. Sakha-94). Wheat grains were co-inoculated with Trichoderma harzianum and Aspergillus niger as phosphate-solubilizing fungi (TD + PSF), and plants were treated with potassium sulfate (K<sub>2</sub>SO<sub>4</sub> 200 mg/l), tryptophan (Try 50 mgL-<sup>1</sup>), K<sub>2</sub>SO<sub>4</sub> (200 mgL-<sup>1</sup>) + Try (50 mgL<sup>−1</sup>), and two concentrations of banana peel extract (BPE) (500 and 1000 mgL-<sup>1</sup>). Results: Yield performance was substantially improved, with increases of 34.2%, 38.9%, and 44.1% in straw yield, biological yield, and grain yield, respectively. Supporting these yield gains, growth characteristics and physiological attributes were significantly enhanced. The combined application of TD + PSF and BPE1000 produced the highest increases in chlorophyll a (31.4%), chlorophyll b (83.6%), total pigments (48.2%), and phenolic compounds (18.9%). Indole-3-acetic acid (IAA) content increased significantly following co-inoculation, with the greatest enhancement (34.9%) recorded under the K₂SO₄ + tryptophan treatment combined with TD + PSF. Grain nutritional quality was also enhanced. The BPE at 1000 mg L<sup>−1</sup> combined with TD + PSF treatment resulted in the highest carbohydrate content (12.5%), whereas BPE500 combined with TD + PSF achieved the greatest increase in grain protein content (33.2%). The combination of K₂SO₄ + tryptophan and TD + PSF significantly improved mineral accumulation, increasing N, P, K, and Mg contents by 33.2, 41.7, 16.2, and 44.2%, respectively. In addition, the highest water productivity (44.12%) was obtained with BPE1000 combined with TD + PSF. The ratio of essential to non-essential amino acids in the grain yield was enriched by approximately 12–15% in plants treated with the combination of TD + PSF and other treatments. This enrichment indicates an improvement in the nutritional quality of the wheat grains, enhancing their value for human dietary needs. Conclusion: Among the tested treatments, the combined application of (TD + PSF) and banana peel extract (1000 mg L⁻<sup>1</sup>) produced the greatest improvements in wheat growth, yield, and grain quality. These findings demonstrate that banana peel extract, particularly when combined with beneficial fungi, is a promising, low-cost, and eco-friendly biostimulant for wheat cultivation in reclaimed sandy soils, while promoting the sustainable utilization of agricultural waste. © The Author(s) 2026.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Feng2026,
	author = {Feng, Xuehuan and Patel, Revanth Sai Kumar Reddy and Yan, Yuchen and Annabhemoju, Vaishnavi and Meinhardt, Lyndel W and Bailey, Bryan and Park, Sunchung and Cohen, Stephen P. and Zhang, Dapeng and Yin, Yanbin},
	title = {Chromosomal-scale and haplotype-resolved genome assembly of the first Trinitario hybrid cacao ICS 1},
	year = {2026},
	journal = {Scientific Data },
	volume = {13},
	number = {1},
	pages = {},
	doi = {10.1038/s41597-026-07054-0},
	url = {https://www.scopus.com/pages/publications/105038445261?origin=resultslist},
	abstract = {Cocoa is a vital agricultural commodity that yields cocoa butter and powder, both essential to the confectionery industry. The Trinitario cacao varieties are key sources of fine flavor beans, among which ICS 1 stands out due to its high productivity and superior bean quality. ICS 1 is also recognized as a valuable parent in breeding programs for desirable agronomic traits such as fine flavor bean quality. Using sequencing reads from PacBio HiFi and Hi-C technologies, we generated two haploid genome assemblies (374.4 Mb and 410.8 Mb), characterized by low scaffold numbers, high N50 values (39.5 Mb and 39.7 Mb), and 10 pseudo-chromosomes. Genome annotation identified 22,477 and 22,263 protein-coding genes, with repeat content of 62.19% and 65.14%, respectively. BUSCO completeness exceeded 98%, confirming high assembly quality. Cacao breeders will benefit from these haploid genomes to develop high-yielding, climate-resilient, fine flavor cacao varieties, addressing challenges such as declining soil fertility, rising disease pressures, and accelerating climate change. © The Author(s) 2026.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Hasibuan2026772,
	author = {Hasibuan, Rosdanelli and Hidayati, Juliza and Khuwailid, Muhammad and Tjandra, Thiodorus Marvin and Pramananda, Viqry},
	title = {Comparative study on the quality and drying kinetics of temulawak by open-sun drying and biomass pyrolysis-integrated flat-bed dryer},
	year = {2026},
	journal = {International Journal of Renewable Energy Development},
	volume = {15},
	number = {4},
	pages = {772 - 784},
	doi = {10.61435/ijred.2026.62014},
	url = {https://www.scopus.com/pages/publications/105044610885?origin=resultslist},
	abstract = {Temulawak is a medicinal plant which is known for its active compound, curcumin. To extend its shelf life, freshly harvested rhizomes are typically subjected to drying to reduce their moisture content. However, the drying process must be carefully controlled to prevent curcumin degradation which is thermolabile. Despite its continued popularity for agricultural commodities drying because it requires minimal equipment and no operational expenses, open-sun drying (OSD) leaves the product vulnerable to external hazards such as dust, environmental pollutants, and ultraviolet exposure. A more suitable alternative is the flat-bed dryer (FBD) system. This study presents a comparison between OSD and an FBD integrated with a pyrolysis reactor for the drying of temulawak. The results demonstrated that the FBD significantly shortened the drying duration to 705 min at 70°C and 1.0 cm-thickness, compared with 2,490 min for OSD at the same thickness. The drying rate in the FBD reached 49.40–56.00 g/m<sup>2</sup> .min, substantially higher than OSD (14.60–16.00 g/m<sup>2</sup> .min). Curcumin content increased in both drying methods as a consequence of moisture reduction, with the FBD achieving 14.82 ppm within a markedly shorter drying time than OSD. Morphological analysis revealed cell-wall shrinkage and deformation of starch granules after drying, particularly in FBD-dried temulawak. Elemental composition analysis showed a considerable increase in mineral fractions after drying, corresponding to the reduction in moisture content. Drying kinetic modelling indicated that the Hasibuan–Daud model provided the best fit for FBD data, whereas the Midilli model offered the closest agreement with the experimental data obtained from OSD. The effective moisture diffusivity obtained for the FBD was 4.970 × 10<sup>-8</sup> m<sup>2</sup> /s, significantly higher than that of OSD, with an activation energy of 29.53 kJ/mol. Overall, the use of an FBD integrated with a pyrolysis reactor offers a sustainable and efficient alternative for the high-quality drying of medicinal plants, outperforming conventional OSD. © 2026. The Author(s).},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Zhang2026,
	author = {Zhang, Fang and Ren, Jianing and Hao, Shuqi and Hu, Yanju and Meng, Xianghong},
	title = {Wavelength-dependent regulation of Penicillium expansum: red and green light promote fungal fitness and patulin accumulation via metabolic homeostasis},
	year = {2026},
	journal = {Food Research International},
	volume = {243},
	pages = {},
	doi = {10.1016/j.foodres.2026.120340},
	url = {https://www.scopus.com/pages/publications/105047243542?origin=resultslist},
	abstract = {Light-based regulation is increasingly employed as an environmentally sustainable physical intervention for preserving postharvest agricultural commodities during storage and transit. Nevertheless, incident light can concurrently modulate the physiological and biochemical dynamics of phytopathogenic fungi, thereby introducing unintended risks to preservation outcomes. In this study, we constructed a customized illumination system integrating discrete wavelengths (green light: 540 nm; red light: 660 nm) and photoperiods (DD, control: continuous darkness; LD: 12 h light/12 h dark cycles; LL: continuous light) to systematically evaluate the impact of light parameters on the development of Penicillium expansum, and to elucidate the mechanistic underpinnings of its photoresponsive behavior. Results showed that both red and green light significantly promoted fungal development. Conidial germination rates increased from 50.43% (DD) to 55.67% (R-LL) and 65.42% (G-LL), respectively. Mycelial growth, sporulation, and PAT production were also markedly enhanced under light exposure. PAT accumulation reached approximately six-fold higher than the control during the early stage (36 h), and remained about two-fold higher at 60 h (R-LL, R-LD, G-LL, G-LD). These phenotypic responses may be attributed to three principal regulatory processes: Enhanced cellular energy metabolism, which supplies the requisite bioenergetic capacity for growth and development; Activation of lipid metabolic pathways coupled with maintenance of redox homeostasis, which collectively facilitate sporulation; Elevated activities of key metabolic enzymes coincident with transcriptional upregulation of genes governing vegetative growth, developmental progression, and mycotoxin biosynthesis. Collectively, these findings provide a theoretical foundation for optimizing light parameters in postharvest photobiological systems and for mitigating the associated risks of fungal contamination. © 2026 Elsevier Ltd},
	publication_stage = {Final}
}

@ARTICLE{Debeli2026,
	author = {Debeli, Yakob Geda and Masho, Tola Jabessa and Argessa, Gemechu Duguma and Gurmu, Mizbawu Kenea and Saketa, Dereje Abdisa and Kuse, Kenenisa Abdisa},
	title = {Determination of selected heavy metals in soil and their impact on coffee bean composition, in case of West Guji Zone, Ethiopia},
	year = {2026},
	journal = {Toxicology Reports},
	volume = {17},
	pages = {},
	doi = {10.1016/j.toxrep.2026.102323},
	url = {https://www.scopus.com/pages/publications/105047709414?origin=resultslist},
	abstract = {Coffee (Coffea arabica L.)is one of the most important agricultural commodities in the world and a major source of income for millions of farmers, with Ethiopia recognized as a center of origin and genetic diversity. Despite the economic importance of specialty coffee produced in the western Guji area, limited information is available on the contamination of coffee-growing soils with heavy metals, the transfer of metals from the soil to the beans and the associated risks to human health. The study measured concentrations of selected heavy metals (Cu, Mn, Zn, Ni, Co, Cr, Cd and Pb) in coffee-growing soils and green coffee beans sampled from the districts of Hambela, Bule Hora and Kercha, and assessed their transport from the soil to the bean. The samples of the soil and coffee beans were digested by an optimized wet acid digestion process and analyzed by Flame Atomic Absorption Spectrometry (FAAS). The analytical method demonstrated excellent linearity (R² = 0.9985–0.9989), good response rates (87–115 mg L⁻¹), and low detection limits (RSD < 5.38 mg). The concentrations of Cu, Mn, Zn, Ni, Co, and Cr in Coffee beans ranged from 20.10 ± 1.30–22.44 ± 1.70, 14.25 ± 1.20–17.14 ± 1.30, 6.74 ± 1.10–8.43 ± 1.10, 1.22 ± 0.20–1.43 ± 0.30, 1.47 ± 0.30–1.49 ± 0.20, and 0.08 ± 0.01–0.92 ± 0.10 mg/kg, respectively, whereas Cd and Pb were below the method detection limits. Soil samples contained comparatively higher metal concentrations, particularly Mn (237.11 ± 3.30–285.44 ± 6.30 mg/kg) and Cu (59.40 ± 2.30–64.40 ± 2.50 mg/kg), However, all values remained below internationally accepted safe limits. The transfer factor values (0.02–0.35) indicated low mobility of metals from the soil to the coffee beans, with Cu being the most mobile of the metals. Metal concentrations in the study areas showed significant differences (p < 0.05) and strong positive correlations between individual metals. The carcinogenic risk (CR) of Cr is 8.7 × 10⁻⁵, which is within the acceptable lifetime risk range as recommended by the USEPA (10<sup>-</sup>⁶ to 10<sup>−4</sup>). The levels of the analyzed heavy metals in green Coffee beans were below the recommended safe levels, which mean that coffee produced in the western Guji zone is safe for human consumption as regards heavy metal contamination. These findings provide valuable input for environmental monitoring, sustainable land management, food safety assessment and quality assurance in specialty coffee from Ethiopia. © 2026 The Authors},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Adugna2026,
	author = {Adugna, Fikadu Berie},
	title = {Explainable vision transformer for coffee leaf nutrient deficiency detection with rule-based treatment recommendation},
	year = {2026},
	journal = {Discover Artificial Intelligence},
	volume = {6},
	number = {1},
	pages = {},
	doi = {10.1007/s44163-026-02160-9},
	url = {https://www.scopus.com/pages/publications/105049515821?origin=resultslist},
	abstract = {Coffee is a worldwide significant agricultural commodity, but nutritional deficits in coffee leaves impair plant health and output, necessitating early and correct diagnosis. Existing deep learning algorithms confront limitations such as common deficiency symptoms, limited datasets, and poor interpretability. This study presents an Explainable Vision Transformer (XViT)-based system for detecting coffee leaf nutrient deficiencies and making rule-based treatment recommendations. The approach improves data variety by preprocessing and class-wise augmentation, whereas XViT collects global and detailed visual patterns for classification. An expert-defined rule-based module makes suitable treatment recommendations, while Grad-CAM visualization enhances model clarity by emphasizing key symptom locations. Experimental results show that the proposed XViT model regularly outperforms baseline architectures such as ResNet-50, EfficientNet-B4, and ConvNeXt. On the initial dataset, XViT achieved 94% precision, 91% recall, 92% F1-score, and accuracy of 94 ± 0.37%, whereas augmentation improved accuracy to 96 ± 0.29%. The rule-based recommendation module achieved 100% rule coverage, 100% rule consistency, a 93.72% end-to-end recommendation success rate, and a Cohen’s Kappa agreement of 0.93 among agricultural specialists. Grad-CAM study indicated that the model concentrates on significant symptom regions linked with nutrient deficits, hence increasing transparency and reliability. Overall, the proposed framework for precision coffee nutrient management is accurate, explainable, and practical since it combines deep learning-based diagnosis with expert-guided treatment. © The Author(s) 2026.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Brun2026,
	author = {Brun, Filippo},
	title = {When GARCH is not enough: Volatility dynamics and extreme tail risk in coffee commodity markets},
	year = {2026},
	journal = {International Review of Economics and Finance},
	volume = {111},
	pages = {},
	doi = {10.1016/j.iref.2026.105767},
	url = {https://www.scopus.com/pages/publications/105048024791?origin=resultslist},
	abstract = {Standard risk models struggle with commodity markets. This paper asks whether that limitation holds for a listed agricultural commodity ETC, and whether semi-parametric methods can overcome it. Using nearly twenty years of daily closing prices from the WisdomTree Coffee ETC (COFF.MI; ISIN: JE00BN7KB557), listed on Borsa Italiana from September 2006 to March 2026, we characterise the statistical and risk properties of a financialised agricultural commodity instrument. The price series conforms to the stylised facts of financial time series — non-stationary prices, stationary returns, pronounced volatility clustering, and fat-tailed return distributions. Among six GARCH-class specifications estimated and compared, the GJR-GARCH model with Student- t innovations is selected as the preferred specification, capturing both size-asymmetric volatility responses and extreme tail behaviour that places the return distribution at the boundary of finite variance and infinite kurtosis. The central finding concerns risk measurement. Rolling-window out-of-sample backtesting shows that all three parametric specifications tested — including the preferred asymmetric model — fail to provide adequate 99% Value-at-Risk coverage, with violation rates of 1.66% to 5.07% against the nominal 1% target. A semi-parametric Extreme Value Theory approach, which models the tail of the empirical loss distribution directly without parametric assumptions, is the only method to achieve adequate coverage (violation rate 1.44%, not rejected at the 1% level), while also providing the first empirical estimate of Expected Shortfall for this asset class (mean 7.97%). Supplementary analysis finds no intra-annual seasonality — consistent with the globally distributed production calendar of coffee — and identifies a dominant medium-term price cycle of approximately 40 months, coherent with the biological production lags of perennial crops. Together, the results demonstrate that the financialised ETC retains the empirical characteristics of the underlying commodity market, and that measuring its tail risk requires methods robust to the structural instability that defeats standard GARCH-based approaches in real-world forecasting settings. © 2026 The Author.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Prakoso2026,
	author = {Prakoso, Havidz Ageng and Bhakti, Aditya Dwi Putra and Ningsih, Gumoyo Mumpuni and Alayda, Vivi},
	title = {Situational analysis of coffee-based ecotourism development: A case study of Amadanom village, Indonesia},
	year = {2026},
	journal = {Multidisciplinary Science Journal},
	volume = {9},
	number = {2},
	pages = {},
	doi = {10.31893/multiscience.2027032},
	url = {https://www.scopus.com/pages/publications/105048290237?origin=resultslist},
	abstract = {This study analyzes the situational conditions for planning a sustainable coffee-based ecotourism area in Amadanom Village, Dampit District, East Java, Indonesia. Using a qualitative descriptive approach with a case study design, data were collected through in-depth interviews with key stakeholders, field observations, and SWOT analysis to examine governance, economic potential, human resources, sociocultural dynamics, and environmental sustainability in line with the United Nations World Tourism Organization (UNWTO) framework. The findings indicate that Amadanom Village has significant strengths to support sustainable ecotourism development, including favorable agroecological conditions such as fertile volcanic soil, suitable altitude, and climate for robusta coffee cultivation, as well as strong social capital rooted in local wisdom, cooperative values, and active farmer institutions. Existing coffee postharvest facilities and educational spaces further enhance the village's potential as a coffee-based education destination. However, the development process faces several constraints, including limited community awareness of sustainable tourism principles, inadequate human resource capacity in tourism management and foreign language skills, weak coordination among stakeholders, insufficient infrastructure, and external threats such as climate change that affect coffee productivity and quality. In addition, limited branding and promotion efforts reduce the destination's visibility and competitiveness. Despite these challenges, Amadanom Village presents substantial opportunities to integrate coffee education, cultural practices, and nature-based tourism into a comprehensive ecotourism model. Strengthening stakeholder collaboration, improving capacity building, enhancing destination branding, and adopting participatory and inclusive governance are crucial to ensuring long-term sustainability. This study contributes to the understanding of sustainable rural tourism by demonstrating how local agricultural commodities and community empowerment can be integrated to create resilient and sustainable ecotourism development. Copyright (c) 2026 The Authors. This work is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

