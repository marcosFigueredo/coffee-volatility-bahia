@ARTICLE{Yang2026,
	author = {Yang, Xue and Li, Wenjie and Wen, Simeng and Li, Hongbin and Yu, Xiaoyan and Lu, Kaihua and Ma, Yunshuang and Feng, Yu and Li, Hong and Shi, Yanan},
	title = {Antifungal mechanism of Limosilactobacillus fermentum A119 against Aspergillus ochraceus in green coffee beans: Targeting amino acid metabolites},
	year = {2026},
	journal = {LWT},
	volume = {253},
	pages = {},
	doi = {10.1016/j.lwt.2026.119605},
	url = {https://www.scopus.com/pages/publications/105041253321?origin=resultslist},
	abstract = {Aspergillus ochraceus ( A. ochraceus ) represents a significant fungal threat during the storage of green coffee beans, leading to substantial economic losses within the industry. In this study, we identified that Limosilactobacillus fermentum (L. fermentum ) strain A119 secretes amino acid and peptide metabolites exhibiting antimicrobial properties. At a minimum fungicidal concentration (MFC) of 1/2, these metabolites effectively inhibited both mycelial growth and spore germination of A. ochraceus . High-performance liquid chromatography (HPLC) analysis demonstrated that the cell-free supernatant (CFS) derived from A119 reduced ochratoxin A (OTA) levels by 30.24%. The inhibitory activity was attributed to the presence of standard amino acids, such as histidine (His), serine (Ser), and proline (Pb), as well as non-standard amino acids including 2-aminoisobutyric acid and theanine. These compounds are hypothesized to disrupt the metabolic pathways involving alanine, aspartic acid, and glutamic acid in A. ochraceus . Whole-genome sequencing revealed that L. fermentum A119 lacks plasmids and does not harbor virulence factors or transferable antibiotic resistance genes. Antibiotic susceptibility testing indicated sensitivity or intermediate sensitivity to penicillins, tetracyclines, cephalosporins, and macrolides, with intrinsic resistance observed only against aminoglycosides and glycopeptides, consistent with established probiotic safety criteria. Moreover, under water activity (AW) conditions of 0.7 and 0.9, treatment with L. fermentum A119 CFS effectively delayed A. ochraceus proliferation, extending the shelf life of green coffee beans from 6 to 9 days (at AW 0.9) to over 20 days (at AW 0.7) relative to untreated controls. Collectively, these findings provide a theoretical basis and microbial resource for the development of natural preservation strategies leveraging probiotics and their bioactive metabolites, thereby enhancing green preservation systems for perishable agricultural commodities such as green coffee beans. Copyright © 2026. Published by Elsevier Ltd.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Zangelidis2026,
	author = {Zangelidis, Leonidas and Rezitis, Anthony N.},
	title = {Topology of intraday realized volatilities across commodity indices, copper futures, the U.S. dollar index, and the NASDAQ: An unrestricted multivariate HAR-VAR approach},
	year = {2026},
	journal = {Resources Policy},
	volume = {117},
	pages = {},
	doi = {10.1016/j.resourpol.2026.105934},
	url = {https://www.scopus.com/pages/publications/105036605784?origin=resultslist},
	abstract = {This study examines volatility connectedness across five main markets, i.e., agricultural commodities (JJA), energy commodities (JJE), copper futures (HG), the U.S. Dollar Index (DX), and the NASDAQ Composite (CQ). We use high-frequency realized volatility and a horizon-dependent connectedness framework by leveraging the Heterogeneous Autoregressive (HAR) model. We present a novel Unrestricted Multivariate HAR (UMHAR) approach with an extended joint connectedness method to capture volatility spillovers at daily, weekly, and monthly horizons. Our sample is from September 28, 2009, to June 7, 2023, and includes key systemic events, such as the aftermath of the global financial crisis, COVID-19, and the Russo-Ukrainian war. Both static and dynamic network analysis show different horizon-specific spillover patterns. Net volatility transmissions primarily occur on the daily horizon, while at the weekly horizon, they are mostly neutralized. On the monthly horizon, the shocks are gradually absorbed over time. The significance of copper as an “economic barometer" is confirmed by its crucial role within the system. Dynamic analysis reveals major peaks in the overall connectedness during systemic crises, suggesting elevated contagion risks. Agricultural commodities become net transmitters during the Russo-Ukrainian war due to supply chain disruptions. During COVID-19, energy commodities changed from being shock absorbers to transmitters. Copper has a significant impact on the system during the 2010-2011 post-crisis industrial recovery. The influence of the U.S. dollar and NASDAQ depends on monetary policy and technology-sector sentiment cycles. We confirm the robustness of our findings by comparing UMHAR-VAR results with alternative model structures, sub-sample tests, and standard VAR-based indices. These results demonstrate how cross-market spillovers are determined by horizon-dependent volatility dynamics. They offer practical insights to market regulators, macroprudential policymakers, and long-term investors who aim to improve portfolio strategies and lower systemic risk. © 2026 Elsevier Ltd.},
	publication_stage = {Final}
}

