	journal = {Results in Engineering},
	volume = {31},
	pages = {},
	doi = {10.1016/j.rineng.2026.111311},
	url = {https://www.scopus.com/pages/publications/105040990127?origin=resultslist},
	abstract = {Gambir is one of the leading agricultural commodities of North Sumatra Province, Indonesia. One of the post-harvest processing steps for gambir leaves is drying. In this work, a flat-bed dryer (FBD) powered by a biomass pyrolysis reactor has been studied for the drying of gambir leaves. The vertical distance of the flat-bed position from the hot air channel was varied (20 cm, 40 cm, 60 cm) to explore their effect on the drying behavior, kinetic, and quality of gambir leaves. The results showed that the optimal flat-bed position was found to be 40 cm, resulting in a drying time of 95 min, a final moisture content of '1%, and the highest drying rate among the positions. The effective moisture diffusivity (D<sub>eff</sub>) ranges from 3.489 × 10<sup>–9</sup> to 8.205 × 10<sup>–9</sup> m<sup>2</sup>/s. The Hasibuan–Daud model was identified as the most suitable for describing the experimental drying data at flat-bed position of 40 cm, while Page model being the best model for flat-bed position of 20 cm and 40 cm. The drying process reduces fatty acid levels as analyzed by GC–MS, and causes shrinkage of the surface of gambier leaves as observed by SEM. Interestingly, drying did not significantly affect the catechin content of gambir leaves, due to the low RH and moderate temperature in the drying chamber. Overall, this drying system is suitable for quickly drying gambir leaves while maintaining their quality. Copyright © 2026. Published by Elsevier B.V.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Bohlol2026,
	author = {Bohlol, Pouya and Majidian, Morteza},
	title = {A hybrid machine learning model for analyzing economic factors and classifying target markets for saffron export},
	year = {2026},
	journal = {Array},
	volume = {31},
	pages = {},
	doi = {10.1016/j.array.2026.101087},
	url = {https://www.scopus.com/pages/publications/105045069285?origin=resultslist},
	abstract = {Strategic selection of export markets has become increasingly important in the competitive global trade environment, particularly for high-value agricultural commodities such as saffron, one of Iran's most significant export products. An analytical and predictive framework was developed to evaluate and classify potential export destinations for Iranian saffron using economic and trade-related indicators. The dataset included 1960 records from 98 countries covering the period 2003–2022 and consisted of nine key economic variables associated with international trade performance. The Technique for Order Preference by Similarity to Ideal Solution (TOPSIS) combined with entropy weighting was employed to rank countries annually according to export attractiveness. Based on average rankings and scores over the twenty-year period, countries were categorized into three export-potential groups: strong, moderate, and weak. To predict these categories, MLP was implemented and achieved 91% classification accuracy with a loss value of 0.2. Comparative analysis demonstrated that the XGBoost algorithm outperformed alternative machine learning models, including SVM, KNN, Decision Tree, and Random Forest, achieving 95% accuracy with a loss value of 0.09. Results confirmed the effectiveness of the proposed hybrid framework in modeling nonlinear economic relationships and identifying promising export markets. The framework provides a scalable, data-driven tool for agricultural export planning, supports evidence-based policymaking, reduces export risk, and enhances Iran's competitiveness in global saffron trade. Furthermore, the proposed approach demonstrates potential for application in broader agricultural trade strategies under dynamic market conditions by assisting policymakers in prioritizing profitable destinations, improving resource allocation efficiency, and strengthening export sustainability. © 2026 The Authors},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Ouyang2026,
	author = {Ouyang, Jianming and Tang, Chaowei},
	title = {Drift-Aware Conformal Prediction for Reliable Potato Price Forecasting under Nonstationary Markets},
	year = {2026},
	journal = {Potato Research},
	volume = {69},
	number = {3},
	pages = {},
	doi = {10.1007/s11540-026-10049-4},
	url = {https://www.scopus.com/pages/publications/105035609211?origin=resultslist},
	abstract = {Accurate forecasting of agricultural commodity prices is essential for stabilizing market expectations and supporting risk-sensitive decisions in production planning and policy intervention. This study proposes Drift-Aware Conformal Prediction (DACP), a plug-and-play calibration framework that converts diverse forecasting backbones into interval predictors with stable reliability under temporal nonstationarity. Unlike conventional deep learning pipelines that emphasize pointwise losses and report only deterministic forecasts, DACP targets decision-ready uncertainty by constructing predictive intervals with controlled coverage through rolling regime-aligned calibration, adaptive coverage control, and shock-aware reset. The proposed framework is model agnostic and can be attached to representative backbones including CNN, LSTM, N-BEATS, Autoformer, and Informer without modifying their architectures. Experiments on weekly potato prices from 25 Chinese provinces between 2012 and 2018 show that DACP consistently improves risk reliability, recovering near nominal coverage under drift while maintaining competitive sharpness, and it yields modest but systematic gains in point forecasting stability across short and longer horizons. These results indicate that conformal calibration with drift awareness provides a principled route to trustworthy uncertainty quantification in agricultural markets, enabling forecasts that are better aligned with operational needs in market regulation and agricultural management. © The Author(s), under exclusive licence to European Association for Potato Research 2026.},
	publication_stage = {Final}
}

@ARTICLE{He2026,
	author = {He, Zenghua and Qi, Te and Liu, Xiangyu and Zhu, Shuaichen and Yang, Yuhan},
	title = {Frequency-Domain Generative Price Diffusion for Potato Time Series Forecasting in Agricultural Management},
	year = {2026},
	journal = {Potato Research},
	volume = {69},
	number = {4},
	pages = {},
	doi = {10.1007/s11540-025-09999-y},
	url = {https://www.scopus.com/pages/publications/105035923900?origin=resultslist},
	abstract = {Accurate forecasting of agricultural commodity prices is vital for maintaining market stability and supporting informed decision-making in production and policy planning. This study introduces the Frequency-domain Generative Price Diffusion (F-GPD) model, a novel approach that redefines agricultural price forecasting as a generative diffusion process operating in the frequency domain. Unlike traditional neural forecasting models that rely on pointwise regression losses, F-GPD captures both amplitude and phase dynamics of market signals through spectral noise injection and frequency-conditioned reconstruction. The model learns to generate coherent price trajectories by progressively denoising spectral representations, thereby aligning temporal patterns with their underlying frequency components. Experiments conducted on weekly potato price data from 25 Chinese provinces between 2012 and 2018 demonstrate that F-GPD consistently outperforms conventional baselines including CNN, LSTM, N-BEATS, Autoformer, and Informer across multiple evaluation metrics. The results confirm that frequency-domain diffusion effectively captures both short-term volatility and long-term periodicity, producing forecasts that are more accurate, stable, and physically interpretable. This work provides a new generative perspective for agricultural time series forecasting and offers a unified framework for modeling stochastic price dynamics under nonstationary market conditions. © The Author(s), under exclusive licence to European Association for Potato Research 2026.},
	publication_stage = {Final}
}

