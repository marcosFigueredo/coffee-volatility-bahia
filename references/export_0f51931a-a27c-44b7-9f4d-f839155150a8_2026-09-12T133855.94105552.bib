}

@ARTICLE{Drira2026,
	author = {Drira, Yesser and Boutouria, Souha and Boujelbène, Mouna},
	title = {A PINN-inspired structure-regularized framework for climate and geopolitical risk in agricultural commodity markets: evidence from China},
	year = {2026},
