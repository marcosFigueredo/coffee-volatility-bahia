	pages = {},
	doi = {10.1016/j.engappai.2026.116029},
	url = {https://www.scopus.com/pages/publications/105047849188?origin=resultslist},
	abstract = {Agricultural commodity markets face challenges from manipulation schemes that exploit pricing inefficiencies and regulatory gaps. To address this, this paper has developed a framework that makes three contributions: first, application of evolutionary game theory to market manipulation detection by modeling markets as adaptive players; second, development of a replicator dynamics framework that captures evolving manipulation strategies without requiring evolutionarily stable equilibria; and third, integration of a latent vector-based recommendation system that quantifies market behavioral patterns and enables cross-market comparison. Our approach addresses problems including detection of manipulation tactics (like spoofing, and pump-and-dump schemes), prediction of price trajectories under strategic interference, and identification of behavioral anomalies across different market environments. The methodology treats markets as adaptive entities whose strategies evolve through replicator dynamics, incorporating payoff calculations and price-setting mechanisms that reach stable strategic distributions over time. Validation using four years of wheat trading data from Central India achieved predictive accuracy of 94%–96% for selling prices while identifying manipulation patterns that traditional methods miss. Analysis across seventeen agricultural trading centers revealed 107 (4.1%) anomalous activities from 2627 transactions, demonstrating the framework’s capacity in providing actionable insights that can enable governing bodies to track, regulate, and curb manipulation practices more effectively. Copyright © 2026. Published by Elsevier Ltd.},
	publication_stage = {Final}
}

@ARTICLE{Handhayani2026,
	author = {Handhayani, Teny and Arisandi, Desi and Wasino, Wasino},
