@ARTICLE{Sung2026,
	author = {Sung, Wen-Tsai and Isa, Indra Griha Tofik and Hsiao, Sung-Jung},
	title = {The multi-growth tea leaf vision detection using the YOLO-based lightweight model and EMA-NLB module},
	year = {2026},
	journal = {Results in Engineering},
	volume = {30},
	pages = {},
	doi = {10.1016/j.rineng.2026.110797},
	url = {https://www.scopus.com/pages/publications/105044409854?origin=resultslist},
	abstract = {In Taiwan, tea is an agricultural commodity that has a high economic value and high demand for both domestic and export needs. The implementation of precision agriculture by developing the vision detection system is one of the mechanisms for maintaining plantation productivity. However, the challenge in monitoring tea leaves visually is that the tiny and multi-intersection object also has a complex background. Therefore, a model is needed that is robust, precise, and lightweight for the model implementation in the edge computing system. In this study, the lightweight Tea-YOLO model has been developed, which is an improvement of the YOLOv10 model, modified with the proposed EMA-NLB module that consists of the efficient multi-scale attention module combined with the non-local block mechanism. By using these two mechanisms, the proposed EMA-NLB module enhances the short and long-range ability to capture the tiny object and focus on the important information within the context of the target object, while maintaining its efficiency. The comparative experiment involving other YOLO-based algorithms and indicates that the proposed model has achieved the optimal mAP50 performance which obtains the percentage of 91.3%, while YOLOv4-tiny, YOLOv7-tiny, YOLOv8, YOLOv10, YOLOv10+EMA, YOLOv10+NLB, YOLOv11, RT-DETR, and EfficientDet-D0 has the mAP<sub>50</sub> percentage of 71.3%, 66.5%, 73.1%, 87.5%, 88.5%, 87.8%, 90.2%, 85.8%, and 87.7%, respectively. Regarding the model efficiency, the proposed model obtains a model size of 11.1 MB and a parameter number of 7.2 M. This indicates the proposed model fit to be implemented in practical applications, especially the tea leaf vision detection with the edge computing system. © 2026 The Author(s).},
