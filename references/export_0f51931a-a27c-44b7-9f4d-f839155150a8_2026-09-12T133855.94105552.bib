@ARTICLE{Deng2026,
	author = {Deng, Xinyan and Aruga, Kentaka and Tang, Chaofeng},
	title = {Bayesian stochastic-volatility structural VAR analysis of cross-market dynamic volatility spillovers among oil, gold, and agricultural commodities},
	year = {2026},
	journal = {International Review of Economics and Finance},
	volume = {110},
	pages = {},
	doi = {10.1016/j.iref.2026.105532},
	url = {https://www.scopus.com/pages/publications/105043016744?origin=resultslist},
	abstract = {This paper examines volatility spillovers among oil, gold, and agricultural commodity markets under two crisis environments, the COVID-19 pandemic and the Russia–Ukraine conflict, using a Bayesian Structural VAR with Stochastic Volatility framework. Methodologically, the paper combines stochastic-volatility-based structural identification with spillover measurement, providing an approach better suited to crisis-period heteroskedasticity than conventional VAR and TVP-VAR specifications. Alternative models are evaluated through forecasting performance, Bayesian criteria, convergence diagnostics, and robustness checks, after which the non-centered BSVAR-SV specification is adopted for the final structural analysis. Empirically, the results show that the later crisis period is associated with a denser transmission structure than the earlier pandemic phase. The normalized total connectedness index increases from 19.14% to 22.12%, indicating stronger system-wide interdependence after the baseline breakpoint. The directional spillover results reveal a differentiated commodity network in which gold acts as the strongest net transmitter, Brent crude oil as the dominant net receiver, and WTI as the more active short-run oil-market transmitter, while the agricultural block is characterized by soybean-led transmission and wheat-side exposure. Pairwise spillovers identify the main bilateral channels, and impulse responses show that the strongest effects are concentrated at short horizons and decay rapidly. The study provides a new methodological tool for identifying cross-commodity risk propagation under extreme events and highlights the need for an integrated early-warning and rebalancing mechanism across the oil–gold–agricultural commodities nexus to enhance systemic resilience.The findings further provide practical guidance for international investors regarding portfolio allocation, benchmark-specific hedging, and cross-commodity risk management under crisis conditions. © 2026 The Authors.},
	publication_stage = {Final},
	note = {All Open Access; Gold Open Access}
}

@ARTICLE{Akil202645,
